# คัดลอกเป็น .env แล้วกรอกค่าจริง (ห้าม commit ไฟล์ .env)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# --- LLM (ค่าเริ่มต้น = Typhoon โมเดลไทย ฟรี) ---
LLM_API_KEY=
# LLM_BASE_URL=https://api.opentyphoon.ai/v1
# LLM_MODEL=typhoon-v2.5-30b-a3b-instruct
#
# ตัวสำรอง: Google Gemini (ฟรี, key จาก aistudio.google.com/apikey)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash
#
# ตัวเลือกเสริม: Claude (ต้อง pip install anthropic และเสียเงิน)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# INPUT_NORM=neg1_1          # หรือ zero_one — ดู docs/CHECKLIST.md ข้อ 3
# CONF_THRESHOLD=0.80
LOG_LEVEL=INFO
